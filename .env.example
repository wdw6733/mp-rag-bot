# 公众号 RAG 机器人 v1.4.1 配置
# 复制成 .env 再填真实值：cp .env.example .env
# .env 绝不要提交到 GitHub。

# --- 公众号（微信公众平台 -> 设置与开发 -> 基本配置）---
# 服务器配置里的 Token，必须和公众号后台填的一致；只用于验签。
MP_TOKEN=
# --- 客服推送（v1.4 新增，可选，默认关闭）---
# MP_APPID / MP_APPSECRET：只在想让慢回答自动推给粉丝时才配。
# 前提是微信认证（300 元/年）：未认证的号调客服消息接口会报 48001，
# 机器人推不出去，慢回答还是靠粉丝发“继续”来取。
# 认证后：开发者平台 -> 我的业务 -> 公众号 -> 基础信息里找 AppID，
# 同一页“开发密钥”里查看/重置 AppSecret，两个都填上就开启自动推送。
# 只填一个不算开启；不填（留空）= 关闭，行为和 v1.3 一样。
MP_APPID=
MP_APPSECRET=

# --- 大模型（OpenAI 兼容接口）---
# 模型不固定，由你自己在 .env 里配，改完 docker compose restart 即可，
# 不用改代码、不用重新打镜像。
# LLM_API_BASE：OpenAI 兼容接口地址，例如 AnyRouter、AgentRouter、官方地址。
LLM_API_BASE=https://anyrouter.top/v1
# LLM_API_KEY：对应上面地址的 Key。
LLM_API_KEY=
# LLM_MODEL：留空=自动（默认，推荐）：启动时调 /v1/models 自动选一个快的；
# 填了就优先用填的，400 模型不存在时自动换下一个。
# 不同网关（AnyRouter / muse2api / wb）的模型名不一样，硬编码一个名字
# 会在别的网关上 400 报错（例如 wb 上 deepseek-chat 不存在），所以留空最省心。
# 想强制指定再填，例如：LLM_MODEL=muse-spark
# 想用 muse-spark 测试（muse2api，内网）：LLM_API_BASE=http://192.168.124.251:18610/v1，
# LLM_MODEL=muse-spark，LLM_TIMEOUT_SEC=20，LLM_FIRST_WAIT_SEC=4（muse2api 慢，
# 首答 4 秒等不到会先回“请稍等，查询中。。。”，后台跑到 20 秒，粉丝发“继续”取结果）。
LLM_MODEL=
# LLM_TIMEOUT_SEC：后台大模型调用的总预算，默认 20 秒（v1.3 改成 20 秒）。
# 微信被动回复必须 5 秒内到，所以机器人不会傻等 20 秒：先等
# LLM_FIRST_WAIT_SEC（默认 4 秒），等不到就先回“请稍等，查询中。。。”占位，
# 后台继续跑到 20 秒，结果缓存 10 分钟，粉丝发“继续”来取。
# 20 秒还没回，就缓存摘录兜底（有摘录回摘录，无摘录回短提示）。
LLM_TIMEOUT_SEC=20
# LLM_FIRST_WAIT_SEC：主请求等后台的第一段等待，默认 4 秒。
# 警告：微信只给 5 秒，这个值千万别超过 4.5 秒，代码里超过也会截断到 4.5 秒；
# 否则占位提示本身都发不出去，粉丝什么都收不到。想调就往小调，别往大调。
LLM_FIRST_WAIT_SEC=4
# LLM_MAX_TOKENS：单次回答 token 上限，默认 400（v1.4 从 800 改成 400，
# 配合 1000 字截断）。回答短了生成就快，4 秒内直接回完的概率更高；想长回答再调大。
LLM_MAX_TOKENS=400
# LLM_SYSTEM_PROMPT：可选，覆盖默认系统提示词。默认提示词是：中文、通俗深度、
# 简短精炼（1000 字内）、不编造命令/参数/端口/版本号。想改口吻再取消注释。
# LLM_SYSTEM_PROMPT=你是公众号 IT 知识助手，用中文简短回答技术问题。

# --- 管理接口 ---
# POST /admin/reload 的鉴权头 X-Admin-Token，填一个足够长的随机字符串。
# 同一个 Token 也用于 POST /admin/unlock（手动解锁被门禁拦住的用户）。
ADMIN_TOKEN=

# --- 新关注门禁（v1.4，不用配）---
# 用量记录存在 ./data/usage.json（容器里是挂载的 /data/usage.json，
# compose 已挂 ./data:/data，重启、升级都不会丢）。不用在 .env 里填，
# 实在想换位置再取消注释：USAGE_FILE=/data/usage.json
# USAGE_FILE=

# --- 其他（一般不用改）---
MP_PORT=18790
