# 公众号 RAG 机器人 v1.2 配置
# 复制成 .env 再填真实值：cp .env.example .env
# .env 绝不要提交到 GitHub。

# --- 公众号（微信公众平台 -> 设置与开发 -> 基本配置）---
# 服务器配置里的 Token，必须和公众号后台填的一致；只用于验签。
MP_TOKEN=
# MP_APPID / MP_APPSECRET：v1.1 不需要，不用配。
# 未认证服务号本来就用不了客服消息（48 小时主动消息），v1.1 也没接
# 客服消息接口；认证后想接再加。

# --- 大模型（OpenAI 兼容接口）---
# 模型不固定，由你自己在 .env 里配，改完 docker compose restart 即可，
# 不用改代码、不用重新打镜像。
# LLM_API_BASE：OpenAI 兼容接口地址，例如 AnyRouter、AgentRouter、官方地址。
LLM_API_BASE=https://anyrouter.top/v1
# LLM_API_KEY：对应上面地址的 Key。
LLM_API_KEY=
# LLM_MODEL：留空=自动（默认，推荐）：启动时调 /v1/models 自动选一个快的；
# 填了就优先用填的，400 模型不存在时自动换下一个。
# 不同网关（AnyRouter / muse2api / wb）的模型名不一样，硬编码一个名字
# 会在别的网关上 400 报错（例如 wb 上 deepseek-chat 不存在），所以留空最省心。
# 想强制指定再填，例如：LLM_MODEL=muse-spark
LLM_MODEL=
# LLM_TIMEOUT_SEC：大模型超时，默认 4 秒。微信只给 5 秒，超时要留 1 秒余量。
# 选快模型（如 deepseek-chat / qwen-turbo 类）更容易在 5 秒内回完；
# 慢的大模型容易超时，粉丝收不到回复。
LLM_TIMEOUT_SEC=4
# LLM_MAX_TOKENS：单次回答 token 上限，默认 800（配合 1000 字截断）。
LLM_MAX_TOKENS=800
# LLM_SYSTEM_PROMPT：可选，覆盖默认系统提示词。默认提示词是：中文、通俗深度、
# 简短精炼（1000 字内）、不编造命令/参数/端口/版本号。想改口吻再取消注释。
# LLM_SYSTEM_PROMPT=你是公众号 IT 知识助手，用中文简短回答技术问题。

# --- 管理接口 ---
# POST /admin/reload 的鉴权头 X-Admin-Token，填一个足够长的随机字符串。
ADMIN_TOKEN=

# --- 其他（一般不用改）---
MP_PORT=18790
